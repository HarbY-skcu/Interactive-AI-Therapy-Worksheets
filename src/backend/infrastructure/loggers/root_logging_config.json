{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "simple": {
      "format": "%(levelname)s - %(message)s"
    },
    "json": {
      "()": "pythonjsonlogger.json.JsonFormatter",
      "format": "%(levelname)s %(message)s %(asctime)s %(name)s %(module)s %(funcName)s %(lineno)d %(threadName)s",
      "rename_fields": {
        "levelname": "level",
        "asctime": "timestamp",
        "name": "logger",
        "funcName": "function",
        "lineno": "line",
        "threadName": "thread_name"
      }
    }
  },
  "filters" : {
    "info_only": {
      "()": "backend.infrastructure.loggers.helpers.request_context.InfoFilter"
    }
  },
  "handlers": {
    "stderr": {
      "class": "logging.StreamHandler",
      "level": "WARNING",
      "formatter": "simple",
      "stream": "ext://sys.stderr"
    },
    "error_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "ERROR",
      "formatter": "json",
      "filename": "logs/errors.log",
      "maxBytes": 2000000,
      "backupCount": 3
    },
    "status_file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "json",
      "filters": ["info_only"],
      "filename": "logs/status.log",
      "maxBytes": 4000000,
      "backupCount": 5
    },
    "queue_handler": {
      "class": "logging.handlers.QueueHandler",
      "handlers": [
        "stderr",
        "error_file",
        "status_file"
      ],
      "respect_handler_level": true
    }
  },
  "loggers": {
    "root": {
      "level": "DEBUG",
      "handlers": ["queue_handler"]
    }
  }
}